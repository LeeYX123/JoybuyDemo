NUXT_API_BASE_INTERNAL=http://127.0.0.1:8000/api/v1
NUXT_PUBLIC_API_BASE=/api/v1

# Crisp 客服挂件（需求 11.2）：crisp.chat 注册网站后拿到的 Website ID。
# 留空 = 不加载客服脚本、不报错；属用户指定的外部服务（铁律例外）。
NUXT_PUBLIC_CRISP_WEBSITE_ID=

# 需求 21（2026-11-22 批次 Y）：Crisp 原生挂件默认关闭，全站改用自研
# 【客服】按钮 + 面板（SupportChatLauncher）。保持 false/留空即可；
# 需要回滚到 Crisp 原生圆形启动器时设为 true（消息镜像不受影响）。
NUXT_PUBLIC_CRISP_WIDGET_ENABLED=false
