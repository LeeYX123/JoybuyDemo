# 后端 API 前缀（folio 引擎 fetch 走同源 /api/v1，dev 由 vite 代理到 127.0.0.1:8000）
VITE_API_BASE_URL=/api/v1

# 商城（storefront）地址：构建期烘焙进 folio 引擎（boot 登录门重定向/登出/切换商城兜底用）。
# 不配置也能按 host 推导：localhost/127.0.0.1/*.localhost → 同 host :3000；
# joyfumi.com 子域（merchant./m.）→ https://www.joyfumi.com；其他 → https://www.joyfumi.com。
# 本地如需显式指定再取消注释：
# VITE_STOREFRONT_URL=http://localhost:3000
