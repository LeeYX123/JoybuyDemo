# Copy this file to .env for local development. Never commit the copied file.
# Values marked CHANGE_ME are placeholders, not usable credentials.

APP_ENV=development
DEBUG=true
APP_TIME_ZONE=Europe/London
APP_LOCALE=en-GB
APP_CURRENCY=GBP

# Local infrastructure (implemented in WP-01)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33060
MYSQL_DATABASE=joybuy
MYSQL_USER=joybuy
MYSQL_PASSWORD=CHANGE_ME_LOCAL_ONLY
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_ONLY
REDIS_PORT=63790
REDIS_URL=redis://127.0.0.1:63790/0
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_UI_PORT=8025

# Application origins (implemented in later work packages)
API_BASE_URL=http://127.0.0.1:8000/api/v1
STOREFRONT_ORIGIN=http://127.0.0.1:3000
ADMIN_WEB_ORIGIN=http://127.0.0.1:5173

# Generate independent values for local use; do not reuse production secrets.
DJANGO_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
SOURCE_FINGERPRINT_HMAC_KEY=CHANGE_ME_LOCAL_ONLY
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_DATABASE_ENGINE=mysql
DJANGO_CACHE_BACKEND=redis
DJANGO_LOG_LEVEL=INFO

# Buyer authentication (WP-05)
BUYER_SESSION_HMAC_KEY=CHANGE_ME_LOCAL_ONLY
BUYER_SESSION_COOKIE_NAME=joybuy_buyer_session
BUYER_SESSION_MAX_AGE_SECONDS=1209600
VERIFICATION_CODE_HMAC_KEY=CHANGE_ME_LOCAL_ONLY
VERIFICATION_CODE_TEST_MODE=true
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_SEND_LIMIT=3
VERIFICATION_CODE_SEND_WINDOW_SECONDS=3600
BUYER_LOGIN_FAILURE_LIMIT=5
BUYER_LOGIN_FAILURE_WINDOW_SECONDS=900

# Staff authentication, RBAC and TOTP (WP-06)
STAFF_SESSION_HMAC_KEY=CHANGE_ME_LOCAL_ONLY
STAFF_SESSION_COOKIE_NAME=joybuy_staff_session
STAFF_SESSION_MAX_AGE_SECONDS=28800
STAFF_TOTP_ENCRYPTION_KEY=CHANGE_ME_LOCAL_ONLY
STAFF_TOTP_PERIOD_SECONDS=30
STAFF_TOTP_ALLOWED_DRIFT_STEPS=1
# Set false only for local development (password-only admin sign-in).
STAFF_TOTP_LOGIN_ENFORCED=true
STAFF_LOGIN_FAILURE_LIMIT=5
STAFF_LOGIN_FAILURE_WINDOW_SECONDS=900

# Crawler control (WP-13). Sessions are stored encrypted; passwords are never saved.
CRAWL_SESSION_ENCRYPTION_KEY=CHANGE_ME_LOCAL_ONLY
CRAWL_RAW_RETENTION_DAYS=30
CRAWL_RAW_ROOT=
